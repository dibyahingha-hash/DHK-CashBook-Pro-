<RootScreenManager>:
    MDMPortalScreen:
        name: 'mdm_portal'

<MDMPortalScreen>:
    ScrollView:
        do_scroll_x: False
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: 16
            spacing: 14

            # Header
            Label:
                text: "PM POSHAN & Cash Book"
                font_size: '20sp'
                bold: True
                size_hint_y: None
                height: '36dp'
                color: 0.15, 0.4, 0.8, 1

            # 1. Month & Days
            GridLayout:
                cols: 2
                size_hint_y: None
                height: '76dp'
                spacing: 8
                Label:
                    text: "Month (YYYY-MM):"
                    size_hint_x: 0.5
                    halign: 'left'
                TextInput:
                    id: in_ym
                    text: "2026-09"
                    multiline: False
                    size_hint_x: 0.5
                Label:
                    text: "Working Days:"
                    size_hint_x: 0.5
                    halign: 'left'
                TextInput:
                    id: in_wd
                    text: "22"
                    multiline: False
                    size_hint_x: 0.5

            # 2. Attendance & Entitlement Inputs
            Label:
                text: "Attendance & Rates"
                bold: True
                size_hint_y: None
                height: '28dp'
                color: 0.2, 0.6, 0.4, 1

            GridLayout:
                cols: 2
                size_hint_y: None
                height: '152dp'
                spacing: 8
                Label:
                    text: "LP Meals Fed:"
                    size_hint_x: 0.5
                TextInput:
                    id: in_lp_meals
                    text: "0"
                    multiline: False
                    size_hint_x: 0.5
                Label:
                    text: "UP Meals Fed:"
                    size_hint_x: 0.5
                TextInput:
                    id: in_up_meals
                    text: "0"
                    multiline: False
                    size_hint_x: 0.5
                Label:
                    text: "LP Rate (Rs.):"
                    size_hint_x: 0.5
                TextInput:
                    id: in_lp_rate
                    text: "6.78"
                    multiline: False
                    size_hint_x: 0.5
                Label:
                    text: "UP Rate (Rs.):"
                    size_hint_x: 0.5
                TextInput:
                    id: in_up_rate
                    text: "10.15"
                    multiline: False
                    size_hint_x: 0.5

            # 3. Rice Inventory Inputs (kg)
            Label:
                text: "Food Grains (Rice in kg)"
                bold: True
                size_hint_y: None
                height: '28dp'
                color: 0.2, 0.6, 0.4, 1

            GridLayout:
                cols: 2
                size_hint_y: None
                height: '76dp'
                spacing: 8
                Label:
                    text: "Rice Opening Balance:"
                    size_hint_x: 0.5
                TextInput:
                    id: in_rice_op
                    text: "0.0"
                    multiline: False
                    size_hint_x: 0.5
                Label:
                    text: "Rice Received (Challan):"
                    size_hint_x: 0.5
                TextInput:
                    id: in_rice_rec
                    text: "0.0"
                    multiline: False
                    size_hint_x: 0.5

            # 4. Cooking Cost Funds Inputs (Rs.)
            Label:
                text: "Cooking Cost Funds (Rs.)"
                bold: True
                size_hint_y: None
                height: '28dp'
                color: 0.2, 0.6, 0.4, 1

            GridLayout:
                cols: 2
                size_hint_y: None
                height: '76dp'
                spacing: 8
                Label:
                    text: "Opening Fund Balance:"
                    size_hint_x: 0.5
                TextInput:
                    id: in_cost_op
                    text: "0.0"
                    multiline: False
                    size_hint_x: 0.5
                Label:
                    text: "Grant Received in Bank:"
                    size_hint_x: 0.5
                TextInput:
                    id: in_cost_rec
                    text: "0.0"
                    multiline: False
                    size_hint_x: 0.5

            # Action Buttons
            BoxLayout:
                size_hint_y: None
                height: '48dp'
                spacing: 12
                Button:
                    text: "Calculate & Save"
                    bold: True
                    background_color: 0.12, 0.5, 0.2, 1
                    on_release: root.calculate_and_save()
                Button:
                    text: "Export PDF"
                    bold: True
                    background_color: 0.15, 0.35, 0.7, 1
                    on_release: root.export_pdf()

            # Result Display Area
            Label:
                text: "Calculation Results"
                bold: True
                size_hint_y: None
                height: '28dp'
                color: 0.2, 0.2, 0.2, 1

            TextInput:
                id: out_results
                text: "Fill in the numbers above and tap 'Calculate & Save'."
                readonly: True
                size_hint_y: None
                height: '160dp'
                font_size: '13sp'
