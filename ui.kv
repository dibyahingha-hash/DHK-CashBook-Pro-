#:kivy 2.0.0

<RootScreenManager>:
    WelcomeScreen:
        name: 'welcome'
    MDMPortalScreen:
        name: 'mdm_portal'
    SMCPortalScreen:
        name: 'smc_portal'

<WelcomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 24
        spacing: 20

        canvas.before:
            Color:
                rgba: (0.95, 0.96, 0.98, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: 100
            orientation: 'vertical'
            spacing: 6
            Label:
                text: "Welcome to DHK"
                font_size: '28sp'
                bold: True
                color: (0.1, 0.15, 0.25, 1)
            Label:
                text: "Elementary School Bookkeeping & Stock Register"
                font_size: '14sp'
                color: (0.4, 0.45, 0.55, 1)

        Widget:
            size_hint_y: 0.1

        BoxLayout:
            orientation: 'vertical'
            spacing: 16
            size_hint_y: None
            height: 220

            Button:
                text: "MDM Portal\n(Stock Register & Savings Cash Book)"
                font_size: '16sp'
                bold: True
                background_normal: ''
                background_color: (0.12, 0.45, 0.85, 1)
                on_release: app.root.current = 'mdm_portal'

            Button:
                text: "SMC Portal\n(Normal Savings & Canara Bank SNA)"
                font_size: '16sp'
                bold: True
                background_normal: ''
                background_color: (0.15, 0.65, 0.45, 1)
                on_release: app.root.current = 'smc_portal'

        Widget:

<MDMPortalScreen>:
    BoxLayout:
        orientation: 'vertical'

        BoxLayout:
            size_hint_y: None
            height: 56
            padding: [8, 4]
            spacing: 8
            canvas.before:
                Color:
                    rgba: (0.12, 0.45, 0.85, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "< Home"
                size_hint_x: None
                width: 75
                background_color: (0.2, 0.55, 0.95, 1)
                on_release: app.root.current = 'welcome'

            Label:
                text: "MDM Administration"
                font_size: '18sp'
                bold: True
                halign: 'left'

        BoxLayout:
            size_hint_y: None
            height: 48
            spacing: 2
            padding: 2

            Button:
                text: "Stock & Meal Register"
                bold: True
                on_release: root.switch_sub_view('stock')
            Button:
                text: "MDM Cash Book (Savings)"
                bold: True
                on_release: root.switch_sub_view('cashbook')

        ScreenManager:
            id: mdm_sub_sm

            Screen:
                name: 'stock_view'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: 16
                        spacing: 12

                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: 105
                            padding: 10
                            canvas.before:
                                Color:
                                    rgba: (0.9, 0.93, 0.97, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [8]

                            Label:
                                text: "Active PM POSHAN Rates (Tap to edit):"
                                color: (0.15, 0.2, 0.3, 1)
                                bold: True
                                size_hint_y: None
                                height: 24

                            BoxLayout:
                                spacing: 8
                                Label:
                                    text: "LP Rate: Rs."
                                    color: (0.2, 0.2, 0.2, 1)
                                    size_hint_x: 0.3
                                TextInput:
                                    id: lp_rate_input
                                    text: "6.78"
                                    multiline: False
                                    size_hint_x: 0.2
                                Label:
                                    text: "UP Rate: Rs."
                                    color: (0.2, 0.2, 0.2, 1)
                                    size_hint_x: 0.3
                                TextInput:
                                    id: up_rate_input
                                    text: "10.15"
                                    multiline: False
                                    size_hint_x: 0.2

                        GridLayout:
                            cols: 2
                            size_hint_y: None
                            height: 440
                            row_default_height: 38
                            spacing: 8

                            Label:
                                text: "Month & Year (YYYY-MM):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: stock_ym
                                text: "2026-09"
                                multiline: False

                            Label:
                                text: "Total Working Days:"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: stock_wd
                                text: "22"
                                multiline: False

                            Label:
                                text: "LP Students Fed (Box 1):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: stock_lp_meals
                                text: "0"
                                multiline: False
                                on_text: root.sync_meals_boxes('from_lp')

                            Label:
                                text: "UP Students Fed (Box 2):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: stock_up_meals
                                text: "0"
                                multiline: False
                                on_text: root.sync_meals_boxes('from_up')

                            Label:
                                text: "Total (LP + UP) (Box 3):"
                                bold: True
                                color: (0.1, 0.3, 0.7, 1)
                            TextInput:
                                id: stock_total_meals
                                text: "0"
                                multiline: False

                            Label:
                                text: "Rice Opening Balance (kg):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: stock_rice_op
                                text: "0"
                                multiline: False

                            Label:
                                text: "Rice Received (kg):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: stock_rice_rec
                                text: "0"
                                multiline: False

                            Label:
                                text: "Oil Opening Balance (L):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: stock_oil_op
                                text: "0"
                                multiline: False

                            Label:
                                text: "Oil Received (L):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: stock_oil_rec
                                text: "0"
                                multiline: False

                        BoxLayout:
                            size_hint_y: None
                            height: 48
                            spacing: 10
                            Button:
                                text: "Save & Calculate Register"
                                bold: True
                                background_color: (0.12, 0.45, 0.85, 1)
                                on_release: root.save_stock_batch()
                            Button:
                                text: "Download PDF"
                                bold: True
                                background_color: (0.0, 0.5, 0.4, 1)
                                on_release: root.export_stock_pdf()

                        Label:
                            id: stock_results_lbl
                            text: "Enter data above to calculate grain and oil balances."
                            color: (0.15, 0.2, 0.3, 1)
                            size_hint_y: None
                            height: 90

            Screen:
                name: 'cashbook_view'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: 16
                        spacing: 12

                        GridLayout:
                            cols: 2
                            size_hint_y: None
                            height: 120
                            row_default_height: 38
                            spacing: 8

                            Label:
                                text: "Month & Year (YYYY-MM):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: mdm_cb_ym
                                text: "2026-09"
                                multiline: False

                            Label:
                                text: "Opening Cash in Hand (Rs.):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: mdm_cb_op_cash
                                text: "0"
                                multiline: False

                            Label:
                                text: "Opening Bank Balance (Rs.):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: mdm_cb_op_bank
                                text: "0"
                                multiline: False

                        Button:
                            text: "Save Opening Balances"
                            size_hint_y: None
                            height: 36
                            on_release: root.save_opening_balances('MDM_SAVINGS')

                        BoxLayout:
                            size_hint_y: None
                            height: 48
                            spacing: 10
                            Button:
                                text: "View Balanced Ledger"
                                bold: True
                                background_color: (0.1, 0.4, 0.75, 1)
                                on_release: root.render_cashbook('MDM_SAVINGS')
                            Button:
                                text: "Export Ledger PDF"
                                bold: True
                                background_color: (0.0, 0.5, 0.4, 1)
                                on_release: root.export_cashbook_pdf('MDM_SAVINGS')

                        Label:
                            id: mdm_cb_summary_lbl
                            text: "Receipts and payments will appear balanced here."
                            size_hint_y: None
                            height: 120
                            color: (0.1, 0.15, 0.2, 1)

<SMCPortalScreen>:
    BoxLayout:
        orientation: 'vertical'

        BoxLayout:
            size_hint_y: None
            height: 56
            padding: [8, 4]
            spacing: 8
            canvas.before:
                Color:
                    rgba: (0.15, 0.65, 0.45, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "< Home"
                size_hint_x: None
                width: 75
                background_color: (0.2, 0.75, 0.55, 1)
                on_release: app.root.current = 'welcome'

            Label:
                text: "SMC Administration (2 Accounts)"
                font_size: '18sp'
                bold: True
                halign: 'left'

        BoxLayout:
            size_hint_y: None
            height: 48
            spacing: 2
            padding: 2

            Button:
                text: "Normal Savings Account"
                bold: True
                on_release: root.switch_smc_view('smc_savings')
            Button:
                text: "Canara Bank SNA (0-Balance)"
                bold: True
                on_release: root.switch_smc_view('smc_canara')

        ScreenManager:
            id: smc_sub_sm

            Screen:
                name: 'smc_savings_view'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: 16
                        spacing: 12

                        Label:
                            text: "Account: Normal Savings Account (Cash & Bank)"
                            bold: True
                            color: (0.15, 0.6, 0.4, 1)
                            size_hint_y: None
                            height: 24

                        GridLayout:
                            cols: 2
                            size_hint_y: None
                            height: 120
                            row_default_height: 38
                            spacing: 8

                            Label:
                                text: "Month & Year (YYYY-MM):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: smc_sav_ym
                                text: "2026-09"
                                multiline: False

                            Label:
                                text: "Opening Cash in Hand (Rs.):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: smc_sav_op_cash
                                text: "0"
                                multiline: False

                            Label:
                                text: "Opening Bank Balance (Rs.):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: smc_sav_op_bank
                                text: "0"
                                multiline: False

                        Button:
                            text: "Save Opening Balances"
                            size_hint_y: None
                            height: 36
                            on_release: root.save_opening_balances('SMC_SAVINGS')

                        BoxLayout:
                            size_hint_y: None
                            height: 48
                            spacing: 10
                            Button:
                                text: "View Balanced Ledger"
                                bold: True
                                background_color: (0.15, 0.65, 0.45, 1)
                                on_release: root.render_cashbook('SMC_SAVINGS')
                            Button:
                                text: "Export Ledger PDF"
                                bold: True
                                background_color: (0.0, 0.5, 0.4, 1)
                                on_release: root.export_cashbook_pdf('SMC_SAVINGS')

                        Label:
                            id: smc_sav_summary_lbl
                            text: "Balanced register summary appears here."
                            size_hint_y: None
                            height: 120
                            color: (0.1, 0.15, 0.2, 1)

            Screen:
                name: 'smc_canara_view'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: 16
                        spacing: 12

                        Label:
                            text: "Account: Canara Bank SNA (Direct Cheque / Vendor Advice)"
                            bold: True
                            color: (0.8, 0.3, 0.1, 1)
                            size_hint_y: None
                            height: 24

                        GridLayout:
                            cols: 2
                            size_hint_y: None
                            height: 80
                            row_default_height: 38
                            spacing: 8

                            Label:
                                text: "Month & Year (YYYY-MM):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: smc_canara_ym
                                text: "2026-09"
                                multiline: False

                            Label:
                                text: "Opening Bank Balance / Limit (Rs.):"
                                color: (0.2, 0.2, 0.2, 1)
                            TextInput:
                                id: smc_canara_op_bank
                                text: "0"
                                multiline: False

                        Button:
                            text: "Save Opening Limit"
                            size_hint_y: None
                            height: 36
                            on_release: root.save_opening_balances('SMC_CANARA')

                        BoxLayout:
                            size_hint_y: None
                            height: 48
                            spacing: 10
                            Button:
                                text: "View Balanced Ledger"
                                bold: True
                                background_color: (0.8, 0.3, 0.1, 1)
                                on_release: root.render_cashbook('SMC_CANARA')
                            Button:
                                text: "Export Ledger PDF"
                                bold: True
                                background_color: (0.0, 0.5, 0.4, 1)
                                on_release: root.export_cashbook_pdf('SMC_CANARA')

                        Label:
                            id: smc_canara_summary_lbl
                            text: "Zero-balance audit summary appears here."
                            size_hint_y: None
                            height: 120
                            color: (0.1, 0.15, 0.2, 1)
