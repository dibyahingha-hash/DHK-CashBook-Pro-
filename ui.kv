#:kivy 2.2.0

<Spacer@Widget>:
    size_hint_y: 1

<PinScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.12, 0.18, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [24, 30, 24, 20]
        spacing: 12

        Spacer:
            size_hint_y: 0.1

        Label:
            text: "DHK CashBook Pro"
            font_size: '22sp'
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: '35dp'

        Label:
            text: "Government School Bookkeeping System"
            font_size: '12sp'
            color: 0.6, 0.7, 0.8, 1
            size_hint_y: None
            height: '20dp'

        Spacer:
            size_hint_y: 0.08

        Label:
            text: root.pin_display
            font_size: '28sp'
            bold: True
            color: 0.3, 0.7, 1.0, 1
            size_hint_y: None
            height: '42dp'

        Label:
            text: root.error_msg
            font_size: '11sp'
            color: 1, 0.3, 0.3, 1
            size_hint_y: None
            height: '20dp'

        GridLayout:
            cols: 3
            spacing: 10
            size_hint_y: 0.6

            Button:
                text: "1"
                font_size: '20sp'
                on_press: root.append_digit(1)
            Button:
                text: "2"
                font_size: '20sp'
                on_press: root.append_digit(2)
            Button:
                text: "3"
                font_size: '20sp'
                on_press: root.append_digit(3)
            Button:
                text: "4"
                font_size: '20sp'
                on_press: root.append_digit(4)
            Button:
                text: "5"
                font_size: '20sp'
                on_press: root.append_digit(5)
            Button:
                text: "6"
                font_size: '20sp'
                on_press: root.append_digit(6)
            Button:
                text: "7"
                font_size: '20sp'
                on_press: root.append_digit(7)
            Button:
                text: "8"
                font_size: '20sp'
                on_press: root.append_digit(8)
            Button:
                text: "9"
                font_size: '20sp'
                on_press: root.append_digit(9)
            Button:
                text: "C"
                font_size: '18sp'
                background_color: 0.7, 0.2, 0.2, 1
                on_press: root.backspace()
            Button:
                text: "0"
                font_size: '20sp'
                on_press: root.append_digit(0)
            Button:
                text: "DEL"
                font_size: '14sp'
                on_press: root.backspace()


<OnboardingScreen>:
    canvas.before:
        Color:
            rgba: 0.95, 0.96, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            orientation: 'vertical'
            padding: [20, 24, 20, 30]
            spacing: 12
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: "School Setup & Baseline"
                font_size: '19sp'
                bold: True
                color: 0.1, 0.15, 0.22, 1
                size_hint_y: None
                height: '35dp'

            Label:
                text: "School Details"
                font_size: '12sp'
                bold: True
                color: 0.35, 0.4, 0.45, 1
                size_hint_y: None
                height: '20dp'

            TextInput:
                id: in_school_name
                hint_text: "School Name (e.g. No 79 Betoni LP)"
                multiline: False
                size_hint_y: None
                height: '46dp'

            TextInput:
                id: in_udise
                hint_text: "11-Digit UDISE Code"
                input_filter: 'int'
                multiline: False
                size_hint_y: None
                height: '46dp'

            Label:
                text: "Opening Balances (September 2026)"
                font_size: '12sp'
                bold: True
                color: 0.35, 0.4, 0.45, 1
                size_hint_y: None
                height: '24dp'

            TextInput:
                id: in_cash
                hint_text: "Opening Cash in Hand (₹)"
                input_filter: 'float'
                multiline: False
                size_hint_y: None
                height: '46dp'

            TextInput:
                id: in_bank
                hint_text: "Opening Bank Balance (₹)"
                input_filter: 'float'
                multiline: False
                size_hint_y: None
                height: '46dp'

            TextInput:
                id: in_grain
                hint_text: "Opening Rice Stock (in Kg, e.g. 150)"
                input_filter: 'float'
                multiline: False
                size_hint_y: None
                height: '46dp'

            Label:
                text: root.status_text
                font_size: '11sp'
                color: 1, 0.2, 0.2, 1
                size_hint_y: None
                height: '22dp'

            Button:
                text: "Save & Begin Accounting"
                bold: True
                background_color: 0.12, 0.55, 0.28, 1
                size_hint_y: None
                height: '50dp'
                on_press: root.save_initial_setup(in_school_name.text, in_udise.text, 9, in_cash.text, in_bank.text, in_grain.text)


<DashboardScreen>:
    canvas.before:
        Color:
            rgba: 0.94, 0.95, 0.97, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 16
        spacing: 12

        BoxLayout:
            size_hint_y: None
            height: '40dp'
            spacing: 8
            Button:
                text: "MDM"
                background_color: (0.1, 0.45, 0.8, 1) if root.selected_account == "MDM" else (0.7, 0.7, 0.7, 1)
                on_press: root.select_account("MDM")
            Button:
                text: "SMC GEN"
                background_color: (0.1, 0.45, 0.8, 1) if root.selected_account == "SMC_GEN" else (0.7, 0.7, 0.7, 1)
                on_press: root.select_account("SMC_GEN")
            Button:
                text: "CANARA SNA"
                background_color: (0.1, 0.45, 0.8, 1) if root.selected_account == "CANARA_SNA" else (0.7, 0.7, 0.7, 1)
                on_press: root.select_account("CANARA_SNA")

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.35
            padding: 14
            spacing: 6
            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10, 10, 10, 10]

            Label:
                text: "Active Month: September 2026"
                color: 0.4, 0.4, 0.4, 1
                font_size: '12sp'
            Label:
                text: "Cash-in-Hand: " + root.cash_display
                color: 0.1, 0.6, 0.2, 1
                font_size: '18sp'
                bold: True
            Label:
                text: "Bank Balance: " + root.bank_display
                color: 0.1, 0.3, 0.7, 1
                font_size: '18sp'
                bold: True
            Label:
                text: "Rice in Stock: " + root.grain_display
                color: 0.5, 0.35, 0.1, 1
                font_size: '14sp'

        Button:
            text: "➕ Record Voucher Expenditure"
            background_color: 0.85, 0.3, 0.2, 1
            size_hint_y: None
            height: '46dp'
            on_press: root.open_new_voucher()

        Button:
            text: "📥 Record Grant / Inflow"
            background_color: 0.2, 0.6, 0.3, 1
            size_hint_y: None
            height: '46dp'

        Button:
            text: "⇄ Self Bank Withdrawal (Contra)"
            background_color: 0.4, 0.3, 0.7, 1
            size_hint_y: None
            height: '46dp'

        Button:
            text: "🖨 Export Audit Cash Book (PDF)"
            background_color: 0.2, 0.3, 0.4, 1
            size_hint_y: None
            height: '46dp'


<VoucherEntryScreen>:
    canvas.before:
        Color:
            rgba: 0.96, 0.97, 0.98, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            orientation: 'vertical'
            padding: [20, 20, 20, 24]
            spacing: 12
            size_hint_y: None
            height: self.minimum_height

            Label:
                text: "New Expenditure — " + root.next_voucher_str
                font_size: '17sp'
                bold: True
                color: 0.1, 0.15, 0.2, 1
                size_hint_y: None
                height: '35dp'

            TextInput:
                id: v_no
                hint_text: "Voucher Number (e.g. 1)"
                multiline: False
                size_hint_y: None
                height: '46dp'

            TextInput:
                id: v_date
                text: "2026-09-30"
                hint_text: "Date (YYYY-MM-DD)"
                multiline: False
                size_hint_y: None
                height: '46dp'

            TextInput:
                id: v_amount
                hint_text: "Amount Spent (₹, e.g. 450.00)"
                input_filter: 'float'
                multiline: False
                size_hint_y: None
                height: '46dp'

            TextInput:
                id: v_purpose
                text: "MDM Cooking Cost (Groceries/Vegetables)"
                hint_text: "Purpose of Expenditure"
                multiline: False
                size_hint_y: None
                height: '46dp'

            Label:
                text: root.error_msg
                font_size: '11sp'
                color: 1, 0.2, 0.2, 1
                size_hint_y: None
                height: '20dp'

            BoxLayout:
                size_hint_y: None
                height: '48dp'
                spacing: 10
                Button:
                    text: "Cancel"
                    background_color: 0.6, 0.6, 0.6, 1
                    on_press: root.cancel()
                Button:
                    text: "✔ Save Entry"
                    background_color: 0.1, 0.6, 0.3, 1
                    on_press: root.save_voucher(v_no.text, v_date.text, v_amount.text, v_purpose.text, "CASH")
