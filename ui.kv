<RootScreenManager>:
    MainScreen:
        name: 'main_screen'

<MainScreen>:
    TabbedPanel:
        do_default_tab: False
        tab_width: root.width / 4
        tab_height: '48dp'

        # ------------------- TAB 1: MDM STOCK -------------------
        TabbedPanelItem:
            text: "Stock"
            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: 12
                    spacing: 8

                    Label:
                        text: "PM POSHAN Stock Register"
                        font_size: '16sp'
                        bold: True
                        size_hint_y: None
                        height: '32dp'
                        color: 0.15, 0.4, 0.8, 1

                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: '240dp'
                        spacing: 6
                        Label:
                            text: "Month (YYYY-MM):"
                        TextInput:
                            id: stock_ym
                            text: "2026-09"
                            multiline: False
                        Label:
                            text: "Working Days:"
                        TextInput:
                            id: stock_wd
                            text: "22"
                            multiline: False
                        Label:
                            text: "LP Meals Fed:"
                        TextInput:
                            id: stock_lp
                            text: "0"
                            multiline: False
                        Label:
                            text: "UP Meals Fed:"
                        TextInput:
                            id: stock_up
                            text: "0"
                            multiline: False
                        Label:
                            text: "Rice Opening (kg):"
                        TextInput:
                            id: stock_rice_op
                            text: "0.0"
                            multiline: False
                        Label:
                            text: "Rice Received (kg):"
                        TextInput:
                            id: stock_rice_rec
                            text: "0.0"
                            multiline: False

                    Label:
                        text: "Cooking Cost Entitlement"
                        bold: True
                        size_hint_y: None
                        height: '28dp'
                        color: 0.2, 0.6, 0.4, 1

                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: '80dp'
                        spacing: 6
                        Label:
                            text: "Cost Opening (Rs.):"
                        TextInput:
                            id: stock_cost_op
                            text: "0.0"
                            multiline: False
                        Label:
                            text: "Grant Received (Rs.):"
                        TextInput:
                            id: stock_cost_rec
                            text: "0.0"
                            multiline: False

                    BoxLayout:
                        size_hint_y: None
                        height: '46dp'
                        spacing: 10
                        Button:
                            text: "Calculate & Save"
                            bold: True
                            background_color: 0.12, 0.5, 0.2, 1
                            on_release: root.save_stock()
                        Button:
                            text: "Export Stock PDF"
                            bold: True
                            background_color: 0.15, 0.35, 0.7, 1
                            on_release: root.export_stock_pdf()

                    TextInput:
                        id: stock_results
                        text: "Enter data above and tap 'Calculate & Save'."
                        readonly: True
                        size_hint_y: None
                        height: '130dp'

        # ------------------- TAB 2: MDM CASH BOOK -------------------
        TabbedPanelItem:
            text: "MDM CB"
            on_press: root.load_cashbook('MDM_SAVINGS')
            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: 12
                    spacing: 8

                    Label:
                        text: "MDM Savings Account Cash Book"
                        font_size: '16sp'
                        bold: True
                        size_hint_y: None
                        height: '32dp'
                        color: 0.15, 0.4, 0.8, 1

                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: '110dp'
                        spacing: 6
                        Label:
                            text: "Month (YYYY-MM):"
                        TextInput:
                            id: mdm_cb_ym
                            text: "2026-09"
                            multiline: False
                        Label:
                            text: "Opening Cash (Rs.):"
                        TextInput:
                            id: mdm_cb_op_cash
                            text: "0.0"
                            multiline: False
                        Label:
                            text: "Opening Bank (Rs.):"
                        TextInput:
                            id: mdm_cb_op_bank
                            text: "0.0"
                            multiline: False

                    Button:
                        text: "Update Opening Balances"
                        size_hint_y: None
                        height: '38dp'
                        background_color: 0.3, 0.5, 0.4, 1
                        on_release: root.save_opening('MDM_SAVINGS', mdm_cb_ym.text, mdm_cb_op_cash.text, mdm_cb_op_bank.text)

                    Label:
                        text: "Record Entry / Voucher"
                        bold: True
                        size_hint_y: None
                        height: '28dp'
                        color: 0.2, 0.6, 0.4, 1

                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: '190dp'
                        spacing: 6
                        Label:
                            text: "Date:"
                        TextInput:
                            id: mdm_e_date
                            text: "2026-09-15"
                            multiline: False
                        Label:
                            text: "Type:"
                        Spinner:
                            id: mdm_e_type
                            text: 'RECEIPT'
                            values: ('RECEIPT', 'PAYMENT', 'CONTRA')
                        Label:
                            text: "Particulars:"
                        TextInput:
                            id: mdm_e_part
                            text: "Purchase of Vegetables"
                            multiline: False
                        Label:
                            text: "Voucher / LF:"
                        TextInput:
                            id: mdm_e_vno
                            text: "1"
                            multiline: False
                        Label:
                            text: "Mode:"
                        Spinner:
                            id: mdm_e_mode
                            text: 'CASH'
                            values: ('CASH', 'BANK')

                    BoxLayout:
                        size_hint_y: None
                        height: '38dp'
                        spacing: 8
                        Label:
                            text: "Amount (Rs.):"
                            size_hint_x: 0.4
                        TextInput:
                            id: mdm_e_amt
                            text: "0.00"
                            multiline: False
                            size_hint_x: 0.6

                    BoxLayout:
                        size_hint_y: None
                        height: '46dp'
                        spacing: 10
                        Button:
                            text: "+ Add Entry"
                            bold: True
                            background_color: 0.12, 0.5, 0.2, 1
                            on_release: root.add_entry('MDM_SAVINGS', mdm_cb_ym.text, mdm_e_date.text, mdm_e_type.text, mdm_e_part.text, mdm_e_vno.text, mdm_e_mode.text, mdm_e_amt.text)
                        Button:
                            text: "Export PDF"
                            bold: True
                            background_color: 0.15, 0.35, 0.7, 1
                            on_release: root.export_cashbook_pdf('MDM_SAVINGS', mdm_cb_ym.text)

                    TextInput:
                        id: mdm_cb_results
                        text: "Cash Book summary will appear here."
                        readonly: True
                        size_hint_y: None
                        height: '130dp'

        # ------------------- TAB 3: SMC SAVINGS CASH BOOK -------------------
        TabbedPanelItem:
            text: "SMC CB"
            on_press: root.load_cashbook('SMC_SAVINGS')
            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: 12
                    spacing: 8

                    Label:
                        text: "SMC Normal Savings Cash Book"
                        font_size: '16sp'
                        bold: True
                        size_hint_y: None
                        height: '32dp'
                        color: 0.15, 0.4, 0.8, 1

                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: '110dp'
                        spacing: 6
                        Label:
                            text: "Month (YYYY-MM):"
                        TextInput:
                            id: smc_cb_ym
                            text: "2026-09"
                            multiline: False
                        Label:
                            text: "Opening Cash (Rs.):"
                        TextInput:
                            id: smc_cb_op_cash
                            text: "0.0"
                            multiline: False
                        Label:
                            text: "Opening Bank (Rs.):"
                        TextInput:
                            id: smc_cb_op_bank
                            text: "0.0"
                            multiline: False

                    Button:
                        text: "Update Opening Balances"
                        size_hint_y: None
                        height: '38dp'
                        background_color: 0.3, 0.5, 0.4, 1
                        on_release: root.save_opening('SMC_SAVINGS', smc_cb_ym.text, smc_cb_op_cash.text, smc_cb_op_bank.text)

                    Label:
                        text: "Record Entry / Voucher"
                        bold: True
                        size_hint_y: None
                        height: '28dp'
                        color: 0.2, 0.6, 0.4, 1

                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: '190dp'
                        spacing: 6
                        Label:
                            text: "Date:"
                        TextInput:
                            id: smc_e_date
                            text: "2026-09-15"
                            multiline: False
                        Label:
                            text: "Type:"
                        Spinner:
                            id: smc_e_type
                            text: 'RECEIPT'
                            values: ('RECEIPT', 'PAYMENT', 'CONTRA')
                        Label:
                            text: "Particulars:"
                        TextInput:
                            id: smc_e_part
                            text: "Composite School Grant"
                            multiline: False
                        Label:
                            text: "Voucher / LF:"
                        TextInput:
                            id: smc_e_vno
                            text: "1"
                            multiline: False
                        Label:
                            text: "Mode:"
                        Spinner:
                            id: smc_e_mode
                            text: 'BANK'
                            values: ('BANK', 'CASH')

                    BoxLayout:
                        size_hint_y: None
                        height: '38dp'
                        spacing: 8
                        Label:
                            text: "Amount (Rs.):"
                            size_hint_x: 0.4
                        TextInput:
                            id: smc_e_amt
                            text: "0.00"
                            multiline: False
                            size_hint_x: 0.6

                    BoxLayout:
                        size_hint_y: None
                        height: '46dp'
                        spacing: 10
                        Button:
                            text: "+ Add Entry"
                            bold: True
                            background_color: 0.12, 0.5, 0.2, 1
                            on_release: root.add_entry('SMC_SAVINGS', smc_cb_ym.text, smc_e_date.text, smc_e_type.text, smc_e_part.text, smc_e_vno.text, smc_e_mode.text, smc_e_amt.text)
                        Button:
                            text: "Export PDF"
                            bold: True
                            background_color: 0.15, 0.35, 0.7, 1
                            on_release: root.export_cashbook_pdf('SMC_SAVINGS', smc_cb_ym.text)

                    TextInput:
                        id: smc_cb_results
                        text: "SMC summary will appear here."
                        readonly: True
                        size_hint_y: None
                        height: '130dp'

        # ------------------- TAB 4: CANARA SNA CASH BOOK -------------------
        TabbedPanelItem:
            text: "SNA CB"
            on_press: root.load_cashbook('SMC_CANARA_SNA')
            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: 12
                    spacing: 8

                    Label:
                        text: "Canara Bank SNA Cash Book"
                        font_size: '16sp'
                        bold: True
                        size_hint_y: None
                        height: '32dp'
                        color: 0.15, 0.4, 0.8, 1

                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: '75dp'
                        spacing: 6
                        Label:
                            text: "Month (YYYY-MM):"
                        TextInput:
                            id: sna_cb_ym
                            text: "2026-09"
                            multiline: False
                        Label:
                            text: "Opening Bank Balance:"
                        TextInput:
                            id: sna_cb_op_bank
                            text: "0.0"
                            multiline: False

                    Button:
                        text: "Update Opening Balance"
                        size_hint_y: None
                        height: '38dp'
                        background_color: 0.3, 0.5, 0.4, 1
                        on_release: root.save_opening('SMC_CANARA_SNA', sna_cb_ym.text, "0.0", sna_cb_op_bank.text)

                    Label:
                        text: "Record Online SNA Payment / Credit"
                        bold: True
                        size_hint_y: None
                        height: '28dp'
                        color: 0.2, 0.6, 0.4, 1

                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: '150dp'
                        spacing: 6
                        Label:
                            text: "Date:"
                        TextInput:
                            id: sna_e_date
                            text: "2026-09-15"
                            multiline: False
                        Label:
                            text: "Type:"
                        Spinner:
                            id: sna_e_type
                            text: 'PAYMENT'
                            values: ('PAYMENT', 'RECEIPT')
                        Label:
                            text: "Particulars:"
                        TextInput:
                            id: sna_e_part
                            text: "Vendor Payment vide PFMS/SNA"
                            multiline: False
                        Label:
                            text: "Advice / Folio No.:"
                        TextInput:
                            id: sna_e_vno
                            text: "1"
                            multiline: False

                    BoxLayout:
                        size_hint_y: None
                        height: '38dp'
                        spacing: 8
                        Label:
                            text: "Bank Amount (Rs.):"
                            size_hint_x: 0.4
                        TextInput:
                            id: sna_e_amt
                            text: "0.00"
                            multiline: False
                            size_hint_x: 0.6

                    BoxLayout:
                        size_hint_y: None
                        height: '46dp'
                        spacing: 10
                        Button:
                            text: "+ Add SNA Entry"
                            bold: True
                            background_color: 0.12, 0.5, 0.2, 1
                            on_release: root.add_entry('SMC_CANARA_SNA', sna_cb_ym.text, sna_e_date.text, sna_e_type.text, sna_e_part.text, sna_e_vno.text, 'BANK', sna_e_amt.text)
                        Button:
                            text: "Export SNA PDF"
                            bold: True
                            background_color: 0.15, 0.35, 0.7, 1
                            on_release: root.export_cashbook_pdf('SMC_CANARA_SNA', sna_cb_ym.text)

                    TextInput:
                        id: sna_cb_results
                        text: "SNA summary will appear here."
                        readonly: True
                        size_hint_y: None
                        height: '130dp'
