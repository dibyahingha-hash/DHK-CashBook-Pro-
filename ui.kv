#:kivy 2.0.0

<RootScreenManager>:
    WelcomeScreen:
        name: 'welcome'
    MDMPortalScreen:
        name: 'mdm_portal'
    SMCPortalScreen:
        name: 'smc_portal'

# ===================================================================
# WELCOME SCREEN (Centered 80% Utilization)
# ===================================================================
<WelcomeScreen>:
    canvas.before:
        Color:
            rgba: (0.94, 0.95, 0.98, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    AnchorLayout:
        anchor_x: 'center'
        anchor_y: 'center'

        BoxLayout:
            orientation: 'vertical'
            size_hint: (0.85, 0.82)
            spacing: 24
            padding: [20, 24]
            canvas.before:
                Color:
                    rgba: (1, 1, 1, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]

            # Header / Branding
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.28
                spacing: 8
                Label:
                    text: "Welcome to DHK"
                    font_size: '28sp'
                    bold: True
                    color: (0.1, 0.15, 0.25, 1)
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size
                Label:
                    text: "Elementary School Bookkeeping\n& PM POSHAN Register"
                    font_size: '15sp'
                    color: (0.4, 0.46, 0.56, 1)
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

            # Action Portals (Big, Touch-Safe Cards)
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.65
                spacing: 20

                Button:
                    text: "MDM Portal\n(Stock Register & Cooking Cost)"
                    font_size: '17sp'
                    bold: True
                    background_normal: ''
                    background_color: (0.12, 0.45, 0.85, 1)
                    on_release: app.root.current = 'mdm_portal'

                Button:
                    text: "SMC Portal\n(Normal Savings & Canara Bank SNA)"
                    font_size: '17sp'
                    bold: True
                    background_normal: ''
                    background_color: (0.15, 0.65, 0.45, 1)
                    on_release: app.root.current = 'smc_portal'

# ===================================================================
# MDM PORTAL SCREEN
# ===================================================================
<MDMPortalScreen>:
    canvas.before:
        Color:
            rgba: (0.94, 0.95, 0.98, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Fixed Header Bar with clean button & title separation
        BoxLayout:
            size_hint_y: None
            height: 64
            padding: [14, 10]
            spacing: 14
            canvas.before:
                Color:
                    rgba: (0.12, 0.45, 0.85, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "< Back"
                size_hint: (None, None)
                size: (85, 44)
                bold: True
                font_size: '15sp'
                background_normal: ''
                background_color: (0.2, 0.55, 0.95, 1)
                on_release: app.root.current = 'welcome'

            Label:
                text: "MDM Administration"
                font_size: '19sp'
                bold: True
                color: (1, 1, 1, 1)
                text_size: self.size
                halign: 'left'
                valign: 'middle'

        # Sub-tab Navigation
        BoxLayout:
            size_hint_y: None
            height: 54
            padding: [8, 4]
            spacing: 8
            canvas.before:
                Color:
                    rgba: (0.86, 0.89, 0.94, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "Stock & Meal Register"
                bold: True
                font_size: '14sp'
                background_normal: ''
                background_color: (0.12, 0.45, 0.85, 1)
                on_release: root.switch_sub_view('stock')
            Button:
                text: "MDM Cash Book (Savings)"
                bold: True
                font_size: '14sp'
                background_normal: ''
                background_color: (0.32, 0.38, 0.48, 1)
                on_release: root.switch_sub_view('cashbook')

        ScreenManager:
            id: mdm_sub_sm

            # TAB 1: STOCK & MEAL REGISTER
            Screen:
                name: 'stock_view'
                ScrollView:
                    do_scroll_x: False
                    AnchorLayout:
                        anchor_x: 'center'
                        size_hint_y: None
                        height: content_box_mdm.height

                        BoxLayout:
                            id: content_box_mdm
                            orientation: 'vertical'
                            size_hint_x: 0.88
                            size_hint_y: None
                            height: self.minimum_height
                            padding: [0, 20, 0, 36]
                            spacing: 18

                            # Active Rates Card
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: 115
                                padding: [16, 12]
                                spacing: 8
                                canvas.before:
                                    Color:
                                    rgba: (1, 1, 1, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10]

                                Label:
                                    text: "Active PM POSHAN Cooking Cost Rates:"
                                    color: (0.1, 0.15, 0.25, 1)
                                    bold: True
                                    font_size: '14sp'
                                    size_hint_y: None
                                    height: 26
                                    text_size: self.size
                                    valign: 'middle'

                                BoxLayout:
                                    spacing: 10
                                    Label:
                                        text: "LP Rate: Rs."
                                        color: (0.1, 0.15, 0.25, 1)
                                        bold: True
                                        font_size: '15sp'
                                        size_hint_x: 0.3
                                        text_size: self.size
                                        valign: 'middle'
                                    TextInput:
                                        id: lp_rate_input
                                        text: "6.78"
                                        multiline: False
                                        font_size: '16sp'
                                        padding: [10, 12]
                                        size_hint_x: 0.2
                                    Label:
                                        text: "UP Rate: Rs."
                                        color: (0.1, 0.15, 0.25, 1)
                                        bold: True
                                        font_size: '15sp'
                                        size_hint_x: 0.3
                                        text_size: self.size
                                        valign: 'middle'
                                    TextInput:
                                        id: up_rate_input
                                        text: "10.15"
                                        multiline: False
                                        font_size: '16sp'
                                        padding: [10, 12]
                                        size_hint_x: 0.2

                            # Register Form Card (Rice & Meals Only)
                            GridLayout:
                                cols: 2
                                size_hint_y: None
                                height: 440
                                row_default_height: 54
                                row_force_default: True
                                spacing: 12
                                padding: [16, 16]
                                canvas.before:
                                    Color:
                                    rgba: (1, 1, 1, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10]

                                Label:
                                    text: "Month & Year (YYYY-MM):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    font_size: '14sp'
                                    bold: True
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: stock_ym
                                    text: "2026-09"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                                Label:
                                    text: "Total Working Days:"
                                    color: (0.1, 0.15, 0.25, 1)
                                    font_size: '14sp'
                                    bold: True
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: stock_wd
                                    text: "22"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                                Label:
                                    text: "LP Students Fed (Classes 1-5):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    font_size: '14sp'
                                    bold: True
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: stock_lp_meals
                                    text: "0"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]
                                    on_text: root.sync_meals_boxes('from_lp')

                                Label:
                                    text: "UP Students Fed (Classes 6-8):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    font_size: '14sp'
                                    bold: True
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: stock_up_meals
                                    text: "0"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]
                                    on_text: root.sync_meals_boxes('from_up')

                                Label:
                                    text: "Total Meals Served:"
                                    bold: True
                                    color: (0.12, 0.45, 0.85, 1)
                                    font_size: '15sp'
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: stock_total_meals
                                    text: "0"
                                    multiline: False
                                    font_size: '16sp'
                                    bold: True
                                    padding: [12, 14]

                                Label:
                                    text: "Rice Opening Balance (kg):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    font_size: '14sp'
                                    bold: True
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: stock_rice_op
                                    text: "0"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                                Label:
                                    text: "Rice Received (kg):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    font_size: '14sp'
                                    bold: True
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: stock_rice_rec
                                    text: "0"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                            # Action Buttons
                            BoxLayout:
                                size_hint_y: None
                                height: 56
                                spacing: 14
                                Button:
                                    text: "Save & Calculate Register"
                                    bold: True
                                    font_size: '15sp'
                                    background_normal: ''
                                    background_color: (0.12, 0.45, 0.85, 1)
                                    on_release: root.save_stock_batch()
                                Button:
                                    text: "Download PDF"
                                    bold: True
                                    font_size: '15sp'
                                    background_normal: ''
                                    background_color: (0.0, 0.55, 0.45, 1)
                                    on_release: root.export_stock_pdf()

                            Label:
                                id: stock_results_lbl
                                text: "Enter data above to calculate grain and cooking cost balances."
                                color: (0.15, 0.2, 0.3, 1)
                                font_size: '14sp'
                                size_hint_y: None
                                height: 70
                                text_size: self.size
                                valign: 'middle'

            # TAB 2: MDM CASH BOOK
            Screen:
                name: 'cashbook_view'
                ScrollView:
                    do_scroll_x: False
                    AnchorLayout:
                        anchor_x: 'center'
                        size_hint_y: None
                        height: content_box_mdm_cb.height

                        BoxLayout:
                            id: content_box_mdm_cb
                            orientation: 'vertical'
                            size_hint_x: 0.88
                            size_hint_y: None
                            height: self.minimum_height
                            padding: [0, 20, 0, 36]
                            spacing: 18

                            GridLayout:
                                cols: 2
                                size_hint_y: None
                                height: 210
                                row_default_height: 54
                                row_force_default: True
                                spacing: 12
                                padding: [16, 16]
                                canvas.before:
                                    Color:
                                    rgba: (1, 1, 1, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10]

                                Label:
                                    text: "Month & Year (YYYY-MM):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    bold: True
                                    font_size: '14sp'
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: mdm_cb_ym
                                    text: "2026-09"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                                Label:
                                    text: "Opening Cash in Hand (Rs.):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    bold: True
                                    font_size: '14sp'
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: mdm_cb_op_cash
                                    text: "0"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                                Label:
                                    text: "Opening Bank Balance (Rs.):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    bold: True
                                    font_size: '14sp'
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: mdm_cb_op_bank
                                    text: "0"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                            Button:
                                text: "Save Opening Balances"
                                size_hint_y: None
                                height: 54
                                bold: True
                                font_size: '15sp'
                                background_normal: ''
                                background_color: (0.2, 0.35, 0.5, 1)
                                on_release: root.save_opening_balances('MDM_SAVINGS')

                            BoxLayout:
                                size_hint_y: None
                                height: 56
                                spacing: 14
                                Button:
                                    text: "View Balanced Ledger"
                                    bold: True
                                    font_size: '15sp'
                                    background_normal: ''
                                    background_color: (0.12, 0.45, 0.85, 1)
                                    on_release: root.render_cashbook('MDM_SAVINGS')
                                Button:
                                    text: "Export Ledger PDF"
                                    bold: True
                                    font_size: '15sp'
                                    background_normal: ''
                                    background_color: (0.0, 0.55, 0.45, 1)
                                    on_release: root.export_cashbook_pdf('MDM_SAVINGS')

                            Label:
                                id: mdm_cb_summary_lbl
                                text: "Double-entry cash book totals will appear balanced here."
                                size_hint_y: None
                                height: 90
                                color: (0.1, 0.15, 0.25, 1)
                                font_size: '14sp'
                                text_size: self.size
                                valign: 'middle'

# ===================================================================
# SMC PORTAL SCREEN
# ===================================================================
<SMCPortalScreen>:
    canvas.before:
        Color:
            rgba: (0.94, 0.95, 0.98, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # Fixed Header Bar
        BoxLayout:
            size_hint_y: None
            height: 64
            padding: [14, 10]
            spacing: 14
            canvas.before:
                Color:
                    rgba: (0.15, 0.65, 0.45, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "< Back"
                size_hint: (None, None)
                size: (85, 44)
                bold: True
                font_size: '15sp'
                background_normal: ''
                background_color: (0.2, 0.75, 0.55, 1)
                on_release: app.root.current = 'welcome'

            Label:
                text: "SMC Administration (2 Accounts)"
                font_size: '19sp'
                bold: True
                color: (1, 1, 1, 1)
                text_size: self.size
                halign: 'left'
                valign: 'middle'

        # Sub-tab Navigation
        BoxLayout:
            size_hint_y: None
            height: 54
            padding: [8, 4]
            spacing: 8
            canvas.before:
                Color:
                    rgba: (0.86, 0.89, 0.94, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: "Normal Savings Account"
                bold: True
                font_size: '14sp'
                background_normal: ''
                background_color: (0.15, 0.65, 0.45, 1)
                on_release: root.switch_smc_view('smc_savings')
            Button:
                text: "Canara Bank SNA (0-Balance)"
                bold: True
                font_size: '14sp'
                background_normal: ''
                background_color: (0.35, 0.4, 0.45, 1)
                on_release: root.switch_smc_view('smc_canara')

        ScreenManager:
            id: smc_sub_sm

            # SMC TAB 1: Normal Savings
            Screen:
                name: 'smc_savings_view'
                ScrollView:
                    do_scroll_x: False
                    AnchorLayout:
                        anchor_x: 'center'
                        size_hint_y: None
                        height: content_box_smc_sav.height

                        BoxLayout:
                            id: content_box_smc_sav
                            orientation: 'vertical'
                            size_hint_x: 0.88
                            size_hint_y: None
                            height: self.minimum_height
                            padding: [0, 20, 0, 36]
                            spacing: 18

                            Label:
                                text: "Account: Normal Savings Account (Cash & Bank)"
                                bold: True
                                color: (0.1, 0.5, 0.35, 1)
                                font_size: '15sp'
                                size_hint_y: None
                                height: 32
                                text_size: self.size
                                valign: 'middle'

                            GridLayout:
                                cols: 2
                                size_hint_y: None
                                height: 210
                                row_default_height: 54
                                row_force_default: True
                                spacing: 12
                                padding: [16, 16]
                                canvas.before:
                                    Color:
                                    rgba: (1, 1, 1, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10]

                                Label:
                                    text: "Month & Year (YYYY-MM):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    bold: True
                                    font_size: '14sp'
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: smc_sav_ym
                                    text: "2026-09"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                                Label:
                                    text: "Opening Cash in Hand (Rs.):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    bold: True
                                    font_size: '14sp'
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: smc_sav_op_cash
                                    text: "0"
                                multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                                Label:
                                    text: "Opening Bank Balance (Rs.):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    bold: True
                                    font_size: '14sp'
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: smc_sav_op_bank
                                    text: "0"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                            Button:
                                text: "Save Opening Balances"
                                size_hint_y: None
                                height: 54
                                bold: True
                                font_size: '15sp'
                                background_normal: ''
                                background_color: (0.2, 0.35, 0.5, 1)
                                on_release: root.save_opening_balances('SMC_SAVINGS')

                            BoxLayout:
                                size_hint_y: None
                                height: 56
                                spacing: 14
                                Button:
                                    text: "View Balanced Ledger"
                                    bold: True
                                    font_size: '15sp'
                                    background_normal: ''
                                    background_color: (0.15, 0.65, 0.45, 1)
                                    on_release: root.render_cashbook('SMC_SAVINGS')
                                Button:
                                    text: "Export Ledger PDF"
                                    bold: True
                                    font_size: '15sp'
                                    background_normal: ''
                                    background_color: (0.0, 0.55, 0.45, 1)
                                    on_release: root.export_cashbook_pdf('SMC_SAVINGS')

                            Label:
                                id: smc_sav_summary_lbl
                                text: "Balanced register summary appears here."
                                size_hint_y: None
                                height: 90
                                color: (0.1, 0.15, 0.25, 1)
                                font_size: '14sp'
                                text_size: self.size
                                valign: 'middle'

            # SMC TAB 2: Canara Bank SNA
            Screen:
                name: 'smc_canara_view'
                ScrollView:
                    do_scroll_x: False
                    AnchorLayout:
                        anchor_x: 'center'
                        size_hint_y: None
                        height: content_box_smc_can.height

                        BoxLayout:
                            id: content_box_smc_can
                            orientation: 'vertical'
                            size_hint_x: 0.88
                            size_hint_y: None
                            height: self.minimum_height
                            padding: [0, 20, 0, 36]
                            spacing: 18

                            Label:
                                text: "Account: Canara Bank SNA (Direct Cheque / Vendor Advice)"
                                bold: True
                                color: (0.75, 0.3, 0.1, 1)
                                font_size: '15sp'
                                size_hint_y: None
                                height: 32
                                text_size: self.size
                                valign: 'middle'

                            GridLayout:
                                cols: 2
                                size_hint_y: None
                                height: 155
                                row_default_height: 54
                                row_force_default: True
                                spacing: 12
                                padding: [16, 16]
                                canvas.before:
                                    Color:
                                    rgba: (1, 1, 1, 1)
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [10]

                                Label:
                                    text: "Month & Year (YYYY-MM):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    bold: True
                                    font_size: '14sp'
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: smc_canara_ym
                                    text: "2026-09"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                                Label:
                                    text: "Opening Bank Balance / Limit (Rs.):"
                                    color: (0.1, 0.15, 0.25, 1)
                                    bold: True
                                    font_size: '14sp'
                                    text_size: self.size
                                    valign: 'middle'
                                TextInput:
                                    id: smc_canara_op_bank
                                    text: "0"
                                    multiline: False
                                    font_size: '16sp'
                                    padding: [12, 14]

                            Button:
                                text: "Save Opening Limit"
                                size_hint_y: None
                                height: 54
                                bold: True
                                font_size: '15sp'
                                background_normal: ''
                                background_color: (0.2, 0.35, 0.5, 1)
                                on_release: root.save_opening_balances('SMC_CANARA')

                            BoxLayout:
                                size_hint_y: None
                                height: 56
                                spacing: 14
                                Button:
                                    text: "View Balanced Ledger"
                                    bold: True
                                    font_size: '15sp'
                                    background_normal: ''
                                    background_color: (0.75, 0.3, 0.1, 1)
                                    on_release: root.render_cashbook('SMC_CANARA')
                                Button:
                                    text: "Export Ledger PDF"
                                    bold: True
                                    font_size: '15sp'
                                    background_normal: ''
                                    background_color: (0.0, 0.55, 0.45, 1)
                                    on_release: root.export_cashbook_pdf('SMC_CANARA')

                            Label:
                                id: smc_canara_summary_lbl
                                text: "Zero-balance audit summary appears here."
                                size_hint_y: None
                                height: 90
                                color: (0.1, 0.15, 0.25, 1)
                                font_size: '14sp'
                                text_size: self.size
                                valign: 'middle'
